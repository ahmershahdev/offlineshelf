# Copy to .env and fill in. Never commit .env.
OFFLINESHELF_ENV=dev
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OFFLINESHELF_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_PASSWORD=change-me-app
OFFLINESHELF_SITE_URL=http://localhost:8080
# Failure emails. Leave SMTP_HOST empty to turn email off.
OFFLINESHELF_SMTP_HOST=
OFFLINESHELF_SMTP_PORT=587
OFFLINESHELF_SMTP_USERNAME=
OFFLINESHELF_SMTP_PASSWORD=
OFFLINESHELF_MAIL_FROM=OfflineShelf <noreply@ahmershah.dev>
